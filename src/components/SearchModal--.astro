---
import Search from "../components/Search.astro";
---

<dialog id="search-modal" class="search-modal">
  <div class="modal-inner">
    <button id="close-search" class="close-btn" aria-label="Cerrar búsqueda"
      >&times;</button
    >
    <!-- Contenedor de Pagefind -->
    <Search
      id="search"
      className="pagefind-ui"
      uiOptions={{ showImages: true }}
    />
  </div>
</dialog>

<style>
  /* Reseteo del dialog nativo */
  .search-modal {
    border: none;
    border-radius: 12px;
    padding: 0;
    width: 90%;
    max-width: 650px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  /* Fondo oscuro automático */
  .search-modal::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(3px); /* Toque moderno */
  }

  .modal-inner {
    background: #fff;
    padding: 2rem;
    position: relative;
  }

  .close-btn {
    position: absolute;
    top: 15px;
    right: 20px;
    background: transparent;
    border: none;
    font-size: 1.5rem;
    color: #666;
    cursor: pointer;
    transition: color 0.2s;
  }

  .close-btn:hover {
    color: #000;
  }
</style>

<script is:inline>
  // Script Vanilla JS para el comportamiento del modal
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.querySelector("#search-modal");
    const closeBtn = document.querySelector("#close-search");

    // Cerrar con el botón
    closeBtn.addEventListener("click", () => modal.close());

    // Mejora UX: Cerrar al hacer clic fuera del contenido (en el backdrop)
    modal.addEventListener("click", (e) => {
      const rect = modal.getBoundingClientRect();
      const isInDialog =
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width;
      if (!isInDialog) {
        modal.close();
      }
    });
  });
</script>
