---
import { Image } from "astro:assets";
import logo from "../assets/Logoelsumario-web.webp";
import bpdvLogo from "../assets/bpdvfooter-300x120.webp";

const categories = [
  { name: "Audiovisual", slug: "audiovisual" },
  { name: "Bienestar y estética", slug: "bienestar-y-estetica" },
  { name: "Buen humor", slug: "buen-humor" },
  { name: "Comunidad", slug: "comunidad" },
  { name: "Deportes", slug: "deportes" },
  { name: "Dinero", slug: "dinero" },
  { name: "Innovación", slug: "innovacion" },
  { name: "Letras que alegran", slug: "letras-que-alegran" },
  { name: "Lo nuestro", slug: "lo-nuestro" },
  { name: "Mundo animal", slug: "mundo-animal" },
  { name: "Perfiles", slug: "perfiles" },
  { name: "Placeres", slug: "placeres" },
];
---

<footer class="site-footer">
  <!-- Top Area: Light Gray Background -->
  <div class="footer-top">
    <div class="container footer-top-grid">
      <!-- Column 1: Logo & Authorization Text -->
      <div class="footer-col col-left">
        <div class="footer-logo">
          <Image src={logo} alt="El Sumario" width={220} height={47} />
        </div>
        <p class="footer-text">
          Autorizamos compartir y/o reproducir los contenidos redaccionales
          citando la respectiva fuente. Es decir, con la condición de colocar en
          la información la correspondiente dirección url del material utilizado
          de nuestra publicación ElSumario.com
        </p>
        <p class="footer-text">
          Esta autorización incluye el uso de videos propios, los cuales tienen
          visible un ícono, logo o marca de agua.
        </p>
      </div>

      <!-- Column 2: Affiliation (BPDV Logo) & Contacts -->
      <div class="footer-col col-middle">
        <div class="affiliation-section">
          <h3 class="col-title">Afiliado a</h3>
          <Image src={bpdvLogo} alt="BPDV" width={260} height={120} />
        </div>

        <div class="contacts-section">
          <h3 class="col-title">Contactos</h3>
          <p class="contact-item">
            <strong>Dirección:</strong>
            <a href="mailto:gfebres@elsumario.com">gfebres@elsumario.com</a>
          </p>
          <p class="contact-item">
            <strong>Ventas:</strong>
            <a href="mailto:comercial@elsumario.com">comercial@elsumario.com</a>
          </p>
        </div>
      </div>

      <!-- Column 3: Editorial Policy -->
      <div class="footer-col col-right">
        <h3 class="col-title">Política editorial</h3>
        <p class="editorial-text">
          Noticias confirmadas. Crónicas en buena onda. Sonidos e imágenes que
          ilustran. Propuestas positivas. Visiones optimistas. Artículos que
          nutren. Voces y personajes que orientan. Consejos que protegen.
          Revelaciones exclusivas. Datos de utilidad. Descubrimientos. Futuro y
          perspectivas. Nuevas tendencias. Textos que aclaran. Informaciones que
          suman.
        </p>
      </div>
    </div>
  </div>

  <!-- Bottom Area: Charcoal Background -->
  <div class="footer-bottom">
    <div class="container">
      <p class="copyright">
        © 2015. Derechos reservados, elsumario.com es un producto y marca del
        Grupo de Comunicación Digital EL SUMARIO, C.A. / RIF: J-40582970-2
      </p>

      <!-- Category Navigation Links -->
      <nav class="footer-category-nav">
        {
          categories.map((cat, idx) => (
            <>
              <a href={`/blog/categoria/${cat.slug}`} class="category-link">
                {cat.name}
              </a>
              {idx < categories.length - 1 && <span class="nav-separator" />}
            </>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  /* Footer Top section styling */
  .footer-top {
    background-color: #ededed;
    padding: 40px 0;
    border-top: 1px solid var(--color-border);
  }

  .footer-top-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr 1fr;
    gap: 40px;
  }

  @media (max-width: 900px) {
    .footer-top-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-logo {
    margin-bottom: 20px;
  }

  .footer-text {
    font-size: 13px;
    color: #444444;
    line-height: 1.6;
    margin-bottom: 16px;
    text-align: justify;
  }

  .footer-text:last-of-type {
    margin-bottom: 0;
  }

  /* Middle Column Titles and Badges */
  .col-title {
    color: var(--color-primary);
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 12px;
    text-align: center;
  }

  .col-right .col-title {
    text-align: right;
  }

  @media (max-width: 900px) {
    .col-title,
    .col-right .col-title {
      text-align: left;
    }
  }

  /* BPDV Logo Custom HTML/CSS representation */
  .affiliation-section {
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (max-width: 900px) {
    .affiliation-section {
      align-items: flex-start;
    }
  }


  /* Contacts Styling */
  .contacts-section {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (max-width: 900px) {
    .contacts-section {
      align-items: flex-start;
    }
  }

  .contact-item {
    font-size: 13.5px;
    color: #444444;
    margin-bottom: 6px;
    line-height: 1.4;
  }

  .contact-item a {
    color: #444444;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-item a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* Editorial Policy text style */
  .editorial-text {
    font-size: 13px;
    color: #444444;
    line-height: 1.7;
    text-align: right;
  }

  @media (max-width: 900px) {
    .editorial-text {
      text-align: justify;
    }
  }

  /* Footer Bottom section styling */
  .footer-bottom {
    background-color: #1a1a1a;
    padding: 30px 0;
    color: #b3b3b3;
    text-align: center;
  }

  .copyright {
    font-size: 12px;
    margin-bottom: 8px;
    color: #ffffff;
    font-weight: 400;
  }

  .source-credits {
    font-size: 11.5px;
    color: #999999;
    margin-bottom: 24px;
  }

  /* Category links styling */
  .footer-category-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px 12px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .category-link {
    color: var(--lime-green);
    font-size: 12.5px;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .category-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .nav-separator {
    width: 4px;
    height: 4px;
    background-color: #555555;
    border-radius: 50%;
    display: inline-block;
  }
</style>
